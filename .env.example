# Copiez ce fichier en ".env" et remplissez les valeurs.
# (Le .env ne doit JAMAIS être commité — il est dans .gitignore)

# --- Catalogue ---
# Chemin vers votre fichier Excel (ou CSV) de produits.
CATALOG_PATH=data/sample_catalog.csv

# --- IA (Étape 2) ---
# Moteur IA : "openai" (payant, fiable), "groq" (gratuit, limité) ou "gemini"
AI_PROVIDER=openai

# OpenAI — clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq — clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — clé : https://aistudio.google.com/app/apikey (nécessite facturation activée)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- WhatsApp Cloud API (Étape 3) ---
# Depuis votre compte Meta Business / Meta for Developers
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Jeton de vérification que VOUS choisissez (chaîne libre), à recopier dans la config du webhook Meta
WHATSAPP_VERIFY_TOKEN=effimarket_verify_2026
