# Copiez ce fichier en ".env" et remplissez les valeurs.
# (Le .env ne doit JAMAIS être commité — il est dans .gitignore)

# --- Catalogue ---
# Chemin vers votre fichier Excel (ou CSV) de produits.
CATALOG_PATH=data/sample_catalog.csv

# --- IA (Étape 2) ---
# "auto" = bascule automatique Groq → OpenAI → Claude (selon les clés présentes).
# Sinon un moteur imposé : "groq", "openai" ou "anthropic".
AI_PROVIDER=auto

# Groq — clé gratuite : https://console.groq.com/keys (prioritaire)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — clé : https://platform.openai.com/api-keys (2e choix)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude — clé : https://console.anthropic.com/ (3e choix)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- WhatsApp Cloud API (Étape 3) ---
# Depuis votre compte Meta Business / Meta for Developers
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Jeton de vérification que VOUS choisissez (chaîne libre), à recopier dans la config du webhook Meta
WHATSAPP_VERIFY_TOKEN=effimarket_verify_2026
